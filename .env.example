# TradeFlow Environment Configuration
# Copy to .env for local overrides. App MUST start cleanly with zero API keys!

# Database
DATABASE_URL=postgresql://tradeflow:tradeflow@postgres:5432/tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=tradeflow
POSTGRES_DB=tradeflow

# Security (change in production)
SECRET_KEY=dev-secret-key-change-in-production-tradeflow-2026
SESSION_COOKIE_NAME=tradeflow_session
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Market Data (Demo seeded data is default; set true to enable yfinance with 60s cache)
ENABLE_YFINANCE=false

# Optional AI & Voice Keys (App works in Demo Mode without these)
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
SARVAM_API_KEY=
WISPR_API_KEY=
